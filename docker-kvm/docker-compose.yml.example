# All 16 blade consoles, one URL each, behind Traefik.
#
# Intended for a MANAGEMENT HOST INSIDE the CMC network (Pi, mini-PC, or a management blade) —
# each container dials its iDRAC at 192.168.0.10<N> directly, so no SSH proxy is involved and all
# 16 can run at once. From outside the management network use ../argo_kvm.sh instead, which routes
# through a single shared `ssh -D` SOCKS proxy.
#
#   docker compose up -d              # all 16
#   docker compose up -d kvm14        # just one
#   docker compose --profile idle up -d   # (nothing extra; profiles reserved for future use)
#
# URLs are HOST-based (blade14.kvm.argo.y4s.io), not path-based (…/blade14). noVNC resolves its
# assets and websocket from the root path, so path-prefix routing needs stripPrefix plus websocket
# rewriting and breaks easily. Subdomains avoid all of that.
#
# Set IDRAC_PASSWORD in a .env file next to this one (and keep it out of git — the repo's
# .gitignore already covers .env).

x-kvm: &kvm
  image: argo-kvm
  build: .
  restart: unless-stopped
  environment: &kvm-env
    IDRAC_USER: "${IDRAC_USER:-root}"
    IDRAC_PASSWORD: "${IDRAC_PASSWORD:?set IDRAC_PASSWORD in .env}"
  networks: [kvm]

x-labels: &labels
  traefik.enable: "true"
  traefik.docker.network: "kvm"

services:
  kvm1:
    <<: *kvm
    container_name: argo-kvm1
    environment: {<<: *kvm-env, IDRAC_HOST: "192.168.0.101:443"}
    labels:
      <<: *labels
      traefik.http.routers.kvm1.rule: "Host(`blade1.kvm.argo.y4s.io`)"
      traefik.http.services.kvm1.loadbalancer.server.port: "5800"

  kvm2:
    <<: *kvm
    container_name: argo-kvm2
    environment: {<<: *kvm-env, IDRAC_HOST: "192.168.0.102:443"}
    labels:
